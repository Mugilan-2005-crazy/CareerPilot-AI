PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/careerpilot_ai
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
AI_SERVICE_URL=http://127.0.0.1:8000
# AI provider: 'deterministic' (baseline), 'ollama', or 'auto'
AI_PROVIDER=deterministic
# Ollama configuration (optional for local LLM)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=your-ollama-model-name
# OLLAMA_TIMEOUT_MS=20000

# SMTP configuration for password-reset emails.
# Leave blank to disable real email delivery; the server will respond safely
# (without leaking whether an account exists) and the reset token will still
# be persisted so a back-office operator can deliver it through an alternate
# channel. Do NOT commit values for SMTP_PASS to source control.
# SMTP_HOST=
# SMTP_SECURE=false
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=CareerPilot AI <no-reply@example.com>
# SMTP_TIMEOUT_MS=10000